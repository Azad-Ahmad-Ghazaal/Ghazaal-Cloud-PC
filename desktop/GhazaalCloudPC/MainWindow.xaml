<Window x:Class="GhazaalCloudPC.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Ghazaal Cloud PC" Width="1360" Height="850" MinWidth="900" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="#101820">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#202020" Padding="8">
   <StackPanel>
    <DockPanel LastChildFill="True">
     <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
      <Button x:Name="BackButton" Content="←" Click="Back_Click" Style="{StaticResource ChromeButton}"/>
      <Button x:Name="ForwardButton" Content="→" Click="Forward_Click" Style="{StaticResource ChromeButton}"/>
      <Button Content="⟳" Click="Reload_Click" Style="{StaticResource ChromeButton}"/>
      <Button Content="⌂" Click="Home_Click" Style="{StaticResource ChromeButton}"/>
     </StackPanel>
     <TextBox x:Name="AddressBox" Height="36" VerticalContentAlignment="Center" FontSize="14"
       Background="#303030" Foreground="White" BorderBrush="#505050" Padding="12,0"
       KeyDown="AddressBox_KeyDown"/>
     <Button Content="Go" Click="Go_Click" Margin="8,0,0,0" Padding="18,6" Background="#0078D4" Foreground="White" BorderThickness="0"/>
    </DockPanel>
    <TabControl x:Name="BrowserTabs" Margin="0,8,0,0" Background="#202020" BorderThickness="0"
      SelectionChanged="BrowserTabs_SelectionChanged">
     <TabControl.Resources>
      <Style TargetType="TabItem">
       <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#303030"/>
       <Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,4,0"/>
      </Style>
     </TabControl.Resources>
    </TabControl>
   </StackPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Background="#202020" Padding="10,6">
   <DockPanel><TextBlock x:Name="StatusText" Foreground="#B8C7D5" Text="Ready · WebView2 browser engine"/>
    <Button DockPanel.Dock="Right" Content="+ New tab" Click="NewTab_Click" Padding="14,4" Background="#303030" Foreground="White" BorderThickness="0"/>
   </DockPanel>
  </Border>
  <Grid x:Name="BrowserHost" Background="#FFFFFF"/>
 </DockPanel>
 <Window.Resources>
  <Style x:Key="ChromeButton" TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#303030"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,7"/>
   <Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontSize" Value="16"/>
  </Style>
 </Window.Resources>
</Window>
